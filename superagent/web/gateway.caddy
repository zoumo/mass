(proxy_request_headers) {
	header_up Host {upstream_hostport}
	header_up -Forwarded
	header_up -X-Forwarded-*
}

(embedded_massd) {
	reverse_proxy {args[0]} {
		import proxy_request_headers
	}
}

(standalone_massd) {
	uri strip_prefix /apis/massd
	reverse_proxy {$SUPERAGENT_MASSD_UPSTREAM:127.0.0.1:24368} {
		import proxy_request_headers
	}
}

(superagent_gateway) {
	route {
		@foreign_origin expression `{http.request.header.Origin} != "" && {http.request.header.Origin} != {http.request.scheme} + "://" + {http.request.hostport}`
		@foreign_site expression `{http.request.header.Sec-Fetch-Site} != "" && {http.request.header.Sec-Fetch-Site} != "same-origin" && {http.request.header.Sec-Fetch-Site} != "none"`
		respond @foreign_origin 403
		respond @foreign_site 403

		@web path /superagent /superagent/*
		handle @web {
			reverse_proxy {args[0]} {
				import proxy_request_headers
				header_up -Authorization
				header_up -Cookie
			}
		}
		handle /apis/massd/* {
			import {args[2]} {args[1]}
		}

		@operator path /apis/core/v1/session-bindings/*/runtime-evidence /apis/core/v1/session-bindings/*/recoveries /apis/core/v1/scheduled-tasks /apis/core/v1/scheduled-tasks/*
		@operator_source_filter {
			path /apis/core/v1/trigger-messages
			query source=*
		}
		@operator_task_filter {
			path /apis/core/v1/trigger-messages
			query scheduledTaskId=*
		}
		respond @operator 404
		respond @operator_source_filter 404
		respond @operator_task_filter 404
		@core path /apis/core/v1/* /livez /readyz /status
		@origin header Origin *
		handle @core {
			reverse_proxy @origin {args[1]} {
				import proxy_request_headers
				header_up Origin http://{upstream_hostport}
				transport http {
					compression off
				}
			}
			reverse_proxy {args[1]} {
				import proxy_request_headers
				transport http {
					compression off
				}
			}
		}
		respond 404
	}
}
