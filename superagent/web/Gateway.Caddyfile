	bind {$SUPERAGENT_GATEWAY_BIND:127.0.0.1}
	import superagent_gateway {$SUPERAGENT_WEB_UPSTREAM:127.0.0.1:24371} {$SUPERAGENT_CORE_UPSTREAM:127.0.0.1:24370} {$SUPERAGENT_MASSD_ROUTE:embedded_massd}
}
