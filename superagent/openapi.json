{
  "components": {
    "schemas": {
      "ComponentStatus": {
        "additionalProperties": false,
        "properties": {
          "observedAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "starting",
              "degraded",
              "unavailable",
              "disabled",
              "not_managed"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "CoreComponentStatus": {
        "additionalProperties": false,
        "properties": {
          "eventStates": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "type": "object"
          },
          "ingress": {
            "type": "string"
          },
          "issueStates": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "type": "object"
          },
          "observedAt": {
            "format": "date-time",
            "type": "string"
          },
          "outboxStates": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "type": "object"
          },
          "router": {
            "type": "string"
          },
          "schemaVersion": {
            "format": "int64",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ready",
              "unavailable"
            ],
            "type": "string"
          },
          "timerStates": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "type": "object"
          },
          "topicStates": {
            "additionalProperties": {
              "format": "int64",
              "type": "integer"
            },
            "type": "object"
          },
          "unknownStops": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "ingress",
          "schemaVersion",
          "router",
          "topicStates",
          "issueStates",
          "eventStates",
          "outboxStates",
          "timerStates",
          "unknownStops"
        ],
        "type": "object"
      },
      "CoreHTTPError": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "currentRevision": {
            "format": "int64",
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "type": "object"
      },
      "JSONRPCError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "format": "int64",
            "type": "integer"
          },
          "data": {},
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "McpHTTPRequest": {
        "additionalProperties": false,
        "properties": {
          "id": {},
          "jsonrpc": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "params": {}
        },
        "required": [
          "jsonrpc",
          "method"
        ],
        "type": "object"
      },
      "McpHTTPResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/JSONRPCError"
          },
          "id": {},
          "jsonrpc": {
            "type": "string"
          },
          "result": {}
        },
        "required": [
          "jsonrpc"
        ],
        "type": "object"
      },
      "OperationError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "reason",
          "message"
        ],
        "type": "object"
      },
      "ProbeState": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "alive",
              "ready",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "StackStatus": {
        "additionalProperties": false,
        "properties": {
          "core": {
            "$ref": "#/components/schemas/CoreComponentStatus"
          },
          "massd": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "status": {
            "enum": [
              "ready",
              "degraded"
            ],
            "type": "string"
          },
          "triggers": {
            "$ref": "#/components/schemas/TriggerStatuses"
          }
        },
        "required": [
          "status",
          "core",
          "massd",
          "triggers"
        ],
        "type": "object"
      },
      "TriggerStatuses": {
        "additionalProperties": false,
        "properties": {
          "dws": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "github": {
            "$ref": "#/components/schemas/ComponentStatus"
          }
        },
        "required": [
          "github",
          "dws"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "massdBearer": {
        "description": "massd instance credential",
        "scheme": "bearer",
        "type": "http"
      },
      "operatorBearer": {
        "description": "Core operator credential",
        "scheme": "bearer",
        "type": "http"
      },
      "roleBearer": {
        "description": "MCP role capability",
        "scheme": "bearer",
        "type": "http"
      },
      "sourceBearer": {
        "description": "Source account credential",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Superagent HTTP API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/livez": {
      "get": {
        "operationId": "coreLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeState"
                }
              }
            },
            "description": "OK"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Core request origin not allowed"
          }
        },
        "summary": "Check that the Core process can respond",
        "tags": [
          "Status"
        ]
      }
    },
    "/massd/jsonrpc": {
      "get": {
        "description": "Available when embedded massd exposure is enabled. A deployment can also mount standalone massd at this prefix.",
        "operationId": "connectMassd",
        "responses": {
          "101": {
            "description": "WebSocket handshake accepted"
          },
          "400": {
            "description": "Invalid WebSocket handshake"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            },
            "description": "massd instance credential required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/CoreHTTPError"
                    },
                    {
                      "$ref": "#/components/schemas/OperationError"
                    }
                  ]
                }
              }
            },
            "description": "Core request host or WebSocket Origin not allowed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "massd exposure disabled"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            },
            "description": "massd admission closed"
          }
        },
        "security": [
          {
            "massdBearer": []
          }
        ],
        "summary": "Upgrade to massd JSON-RPC over WebSocket",
        "tags": [
          "massd"
        ]
      }
    },
    "/massd/livez": {
      "get": {
        "description": "Available when embedded massd exposure is enabled. A deployment can also mount standalone massd at this prefix.",
        "operationId": "massdLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeState"
                }
              }
            },
            "description": "Successful probe"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Core request host not allowed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "massd exposure disabled"
          }
        },
        "summary": "Check that the massd process can respond",
        "tags": [
          "massd"
        ]
      }
    },
    "/massd/readyz": {
      "get": {
        "description": "Available when embedded massd exposure is enabled. A deployment can also mount standalone massd at this prefix.",
        "operationId": "massdReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeState"
                }
              }
            },
            "description": "Successful probe"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Core request host not allowed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "massd exposure disabled"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            },
            "description": "massd admission closed"
          }
        },
        "summary": "Check that massd can admit requests",
        "tags": [
          "massd"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "coreReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeState"
                }
              }
            },
            "description": "OK"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Core request origin not allowed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeState"
                }
              }
            },
            "description": "Core admission unavailable"
          }
        },
        "summary": "Check that Core can admit requests",
        "tags": [
          "Status"
        ]
      }
    },
    "/status": {
      "get": {
        "description": "Returns partial status when a component is unavailable. In standalone Core, GitHub and DWS are not managed. Timer state is reported by Core.",
        "operationId": "getStackStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StackStatus"
                }
              }
            },
            "description": "OK"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Core request origin not allowed"
          }
        },
        "summary": "Read Core, massd and built-in Trigger status",
        "tags": [
          "Status"
        ]
      }
    },
    "/v1/mcp": {
      "post": {
        "operationId": "callRoleMcp",
        "parameters": [
          {
            "in": "header",
            "name": "MCP-Protocol-Version",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/McpHTTPRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/McpHTTPResponse"
                }
              }
            },
            "description": "JSON-RPC reply"
          },
          "202": {
            "description": "Notification accepted"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/McpHTTPResponse"
                    },
                    {
                      "$ref": "#/components/schemas/CoreHTTPError"
                    }
                  ]
                }
              }
            },
            "description": "Invalid request or protocol version"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Role credential required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Role request forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Role binding is stale"
          },
          "413": {
            "description": "Request too large"
          },
          "415": {
            "description": "Content-Type must be application/json"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoreHTTPError"
                }
              }
            },
            "description": "Core unavailable"
          }
        },
        "security": [
          {
            "roleBearer": []
          }
        ],
        "summary": "Exchange role MCP JSON-RPC messages",
        "tags": [
          "MCP"
        ]
      }
    }
  }
}
